HIKMAH_BACKEND_URL=https://vilgghdzyqdsvbaazphh.supabase.co/functions/v1/hikmah-api
# Server-only secret. Configure securely on the hosting provider.
HIKMAH_BACKEND_TOKEN=
# Optional, Functions-scoped, Deploy Previews context only. Keep production on its own backend.
# HIKMAH_PREVIEW_BACKEND_URL=https://vilgghdzyqdsvbaazphh.supabase.co/functions/v1/hikmah-api-candidate

# Public Auth configuration, required at build time and runtime.
NEXT_PUBLIC_SUPABASE_URL=https://vilgghdzyqdsvbaazphh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Error monitoring (Sentry). All optional: without the DSN nothing is sent.
# The DSN must belong to an EU (Germany) organisation: https://<key>@o<org>.ingest.de.sentry.io/<project>.
# Any other host is rejected in code. A DSN is not a secret, but keep it out of source.
NEXT_PUBLIC_SENTRY_DSN=
# Organisation slug: used for source map upload at build time and by the admin Health tab.
# SENTRY_ORG=
# Build only, for readable stack traces. Secret; Builds scope. Needs SENTRY_ORG and SENTRY_PROJECT.
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Server only, for the admin Health tab. Secret; read-only token with the event:read scope. Never NEXT_PUBLIC_.
# SENTRY_ISSUES_TOKEN=
# The Edge Function reads its own SENTRY_DSN from Supabase function secrets, not from this file.
